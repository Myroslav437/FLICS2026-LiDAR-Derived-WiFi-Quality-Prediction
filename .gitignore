# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.Python
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- IDE / editor ----
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Test / coverage ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Generated / intermediate artifacts ----
# Keep the directory itself (via .gitkeep) but ignore everything inside.
artifacts/*
!artifacts/.gitkeep
scripts/**/cache/
scripts/**/__pycache__/
scripts/extracted/
scripts/summaries/
scripts/**/*_backup/
scripts/**/artifacts/

# ---- LaTeX build outputs (paper) ----
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.toc
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.synctex.gz
docs/paper/*.fls
docs/paper/*.fdb_latexmk

# ---- Migration / audit scratch files ----
# Pre/post-migration SHA dumps generated by the leakage-fix rerun helpers.
# The durable audit trail lives in MIGRATION_LOG.md; these dot-files are
# scratch input that the helpers consume.
.phase0_sha_pre.txt
.pre_deletion_shas.txt

# ---- Misc ----
*.log
*.tmp
*.bak
