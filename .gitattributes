# Git LFS — track large binary dataset files.
# Patterns are scoped to data/ so small text CSVs elsewhere stay out of LFS.

data/**/*.h5            filter=lfs diff=lfs merge=lfs -text
data/**/*.csv           filter=lfs diff=lfs merge=lfs -text
data/**/*.parquet       filter=lfs diff=lfs merge=lfs -text
data/**/*.npz           filter=lfs diff=lfs merge=lfs -text
data/**/*.ntm           filter=lfs diff=lfs merge=lfs -text
data/**/*.ntt           filter=lfs diff=lfs merge=lfs -text

# Pipeline-output binary artifacts checked in alongside the scripts that
# generate them (anomaly masks, residual parquets, backed-up artifact
# snapshots, etc.). `scripts/**/cache/` is git-ignored so these patterns
# only catch the durable artifact and v*_backup directories.
scripts/**/*.parquet    filter=lfs diff=lfs merge=lfs -text
scripts/**/*.h5         filter=lfs diff=lfs merge=lfs -text
scripts/**/*.npz        filter=lfs diff=lfs merge=lfs -text

# Generated PDFs of analysis reports (often regenerated, can be sizable).
docs/**/*.pdf           filter=lfs diff=lfs merge=lfs -text

# Line-ending normalization
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.tex    text eol=lf
*.cls    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf

# Trained-model snapshots (XGBoost JSON) — multi-MB serialized boosters
# with no useful line-by-line diff (the H2_randval diagnostic model is
# ~32 MB on its own). Route through LFS as binary; placed after the
# *.json text-normalization rule so -text and the LFS filter win.
scripts/**/models/*.json    filter=lfs diff=lfs merge=lfs -text
